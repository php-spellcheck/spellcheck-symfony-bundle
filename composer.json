{
    "name": "php-spellcheck/spellcheck-symfony-bundle",
    "description": "Spell check Symfony translations and PHP code in CI. Hunspell/Aspell backends, ICU aware, baseline for legacy projects.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony", "symfony-bundle", "spell-checker", "spellcheck", "spelling", "php", "hunspell", "aspell", "translations", "i18n", "l10n", "code-quality", "static-analysis", "linter", "typo", "icu", "continuous-integration", "developer-tools"
    ],
    "license": "MIT",
    "homepage": "https://github.com/php-spellcheck/spellcheck-symfony-bundle",
    "support": {
        "issues": "https://github.com/php-spellcheck/spellcheck-symfony-bundle/issues",
        "source": "https://github.com/php-spellcheck/spellcheck-symfony-bundle",
        "docs": "https://github.com/php-spellcheck/spellcheck-symfony-bundle#readme"
    },
    "authors": [
        {
            "name": "Raffaele Carelle",
            "email": "raffaele.carelle@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "php-spellcheck/spellcheck-core": "dev-main",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/translation": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "matthiasnoback/symfony-config-test": "^4.3 || ^5.0",
        "matthiasnoback/symfony-dependency-injection-test": "^4.3 || ^5.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^9.6",
        "symfony/cache": "^5.4 || ^6.4 || ^7.0",
        "symfony/filesystem": "^5.4 || ^6.4 || ^7.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "PHPSpellcheck\\SpellcheckBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPSpellcheck\\SpellcheckBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
